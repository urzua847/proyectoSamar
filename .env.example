# =====================================================
# PROYECTO SAMAR - CONFIGURACIÓN DE ENTORNO
# =====================================================
# IMPORTANTE: Renombrar este archivo a .env y configurar
# con los valores reales de tu entorno.
# ⚠️ NUNCA commitear el archivo .env a git (ya está en .gitignore)
# =====================================================

# --- ENTORNO DE EJECUCIÓN ---
# Opciones: 'development' | 'production'
# ⚠️ CRÍTICO: En producción, TypeORM NO sincronizará esquema automáticamente
# Cambios de esquema deben hacerse mediante migraciones
NODE_ENV=development

# --- SERVIDOR EXTERNO (Nginx/Público) ---
HOST=0.0.0.0
PORT=80

# --- CONFIGURACIÓN INTERNA BACKEND ---
# Host de la base de datos (usa nombre del servicio Docker)
DOCKER_DB_HOST=samar_db     
BACKEND_PORT=5000      

# --- POSTGRESQL ---
# Docker usará estos datos para CREAR la base de datos automáticamente
DB_USERNAME=postgres
DATABASE=nombre_db
PASSWORD=tu_password_seguro_aqui

# --- SECURITY (JWT & Sessions) ---
# ⚠️ IMPORTANTE: Generar claves seguras en producción
# Ejemplo: openssl rand -base64 64
ACCESS_TOKEN_SECRET=cambiar_por_clave_segura_minimo_32_caracteres
cookieKey=cambiar_por_otra_clave_segura_minimo_32_caracteres

# --- CORS (Opcional - Para producción) ---
# Lista de dominios permitidos separados por coma
# Ejemplo: ALLOWED_ORIGINS=https://tudominio.com,https://app.tudominio.com
# ALLOWED_ORIGINS=http://localhost:5173